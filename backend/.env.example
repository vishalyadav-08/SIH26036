# Copy to .env and fill in. Never commit .env.
SECRET_KEY=django-insecure-change-me-before-any-deployment
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Leave unset to fall back to SQLite while getting started.
# DATABASE_URI=postgres://mapansetu:mapansetu@localhost:5432/mapansetu

# Object storage (ADR-007). Leave unset to store files on local disk.
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=mapansetu

# Console backend prints emails to the terminal; no SMTP needed in development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@mapansetu.test
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# Google sign-in. Unset means the /auth/google endpoint is disabled.
# GOOGLE_OAUTH_CLIENT_ID=xxxxx.apps.googleusercontent.com
