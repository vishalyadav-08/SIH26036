# Copy to .env and fill in. Never commit .env.
SECRET_KEY=django-insecure-change-me-before-any-deployment
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Database ─────────────────────────────────────────────────────────────────
# Leave unset to fall back to SQLite while getting started.
# Production: copy the "URI" from Supabase → Settings → Database → Connection string
# DATABASE_URI=postgres://user:password@db.xxx.supabase.co:5432/postgres

# ── Supabase Storage (S3-compatible) ─────────────────────────────────────────
# In Supabase dashboard:
#   1. Storage → Create Bucket → name it "mapansetu" → uncheck "Public bucket"
#   2. Settings → Storage → S3 Connection → copy Endpoint + Region
#   3. Settings → Storage → S3 Access Keys → New access key → copy both keys
# Leave unset to store files on local disk (development only).
# MINIO_ENDPOINT=https://<PROJECT_REF>.supabase.co/storage/v1/s3
# MINIO_ACCESS_KEY=<Supabase S3 Access Key ID>
# MINIO_SECRET_KEY=<Supabase S3 Secret Access Key>
# MINIO_BUCKET=mapansetu
# MINIO_REGION=ap-southeast-1

# ── Email (Resend SMTP — production) ─────────────────────────────────────────
# Sign up at https://resend.com (free: 3 000 emails/month, 100/day)
# → API Keys → Create API Key → copy the key (re_xxxxxxxxxx)
# → Domains → Add your domain and verify DNS records
# Console backend prints emails to the terminal; no SMTP needed in development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@mapansetu.test
# Production — uncomment and fill in:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DEFAULT_FROM_EMAIL=no-reply@yourdomain.com

# ── Google sign-in ────────────────────────────────────────────────────────────
# Unset means the /auth/google endpoint is disabled.
# GOOGLE_OAUTH_CLIENT_ID=xxxxx.apps.googleusercontent.com

# ── Certificate signing (ADR-011, CRYPTOGRAPHY.md section 6) ─────────────────
# Prototype key material, injected through environment configuration and
# labelled non-production. The private key is never committed or logged.
# Production requires a managed key store / HSM.
# Generate with: python manage.py shell -c "from certificates.crypto import generate_keypair; print(generate_keypair()[0])"
# CERTIFICATE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# CERTIFICATE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"

# ── Access token lifetime ─────────────────────────────────────────────────────
# Access token lifetime in minutes. Prototype default is 480 (8h) because there
# is no refresh endpoint yet. Shorten this in production.
# ACCESS_TOKEN_MINUTES=480
